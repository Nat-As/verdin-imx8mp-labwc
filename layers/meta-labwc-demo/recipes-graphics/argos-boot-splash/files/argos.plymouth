[Plymouth Theme]
Name=Argos
Description=Alakai logo with a spinner, from power-up until the labwc desktop is up
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/argos
Font=DejaVu Sans 12
TitleFont=DejaVu Sans 13
# Logo slightly above the middle, spinner below it
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
HorizontalAlignment=.5
VerticalAlignment=.75
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.75
# The release version (Title of [boot-up]) at the bottom
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.94
MessageBelowAnimation=true
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x303030
ProgressBarForegroundColor=0xb70505

[boot-up]
UseEndAnimation=false
Title=v@VERSION@

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
