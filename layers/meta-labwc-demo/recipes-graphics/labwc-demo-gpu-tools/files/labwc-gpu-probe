#!/bin/bash
# labwc-gpu-probe: start labwc once per GPU renderer strategy, with two test
# windows (a white terminal, and GPU Test, an OpenGL ES application), and
# report which strategies work. A crash is run under gdb and its backtrace is
# printed.
#
#   sudo labwc-gpu-probe                 headless test of all strategies (the
#                                        desktop keeps running)
#   sudo labwc-gpu-probe --kms           test on the real displays: stops the
#                                        desktop, shows the test windows with
#                                        each strategy, asks whether they were
#                                        visible, then restarts the desktop
#   sudo labwc-gpu-probe gles2 pixman    test only these strategies
#
# Strategies are the ones of labwc-session (/etc/default/labwc):
#   gles2-render gles2 gles2-device pixman
# Logs: /tmp/labwc-gpu-probe-<time>/
set -u

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

KMS=0
SECONDS_PER_TEST=${SECONDS_PER_TEST:-8}
STRATEGIES=()
while [ $# -gt 0 ]; do
    case $1 in
    --kms) KMS=1 ;;
    -t) SECONDS_PER_TEST=$2; shift ;;
    -h|--help) usage ;;
    -*) usage 1 ;;
    *) STRATEGIES+=("$1") ;;
    esac
    shift
done
[ ${#STRATEGIES[@]} -gt 0 ] || STRATEGIES=(gles2-render gles2 gles2-device pixman)

if [ "$(id -u)" -ne 0 ]; then
    echo "labwc-gpu-probe: run as root (sudo labwc-gpu-probe)" >&2
    exit 1
fi

render_node=
for n in /sys/class/drm/renderD*; do
    [ -e "$n" ] && { render_node=/dev/dri/${n##*/}; break; }
done
kms_card=
for c in /sys/class/drm/card[0-9]*; do
    case ${c##*/} in *-*) continue ;; esac
    for conn in "$c"-*; do
        [ -e "$conn" ] && { kms_card=/dev/dri/${c##*/}; break 2; }
    done
done

outdir=/tmp/labwc-gpu-probe-$(date +%Y%m%d-%H%M%S)
mkdir -p "$outdir"
runtime=$(mktemp -d /tmp/labwc-probe-runtime.XXXXXX)
chmod 0700 "$runtime"
cfg=$(mktemp -d /tmp/labwc-probe-config.XXXXXX)
# Empty labwc config dir: no autostart (panel, wallpaper), default settings

restart_desktop=0
cleanup() {
    rm -rf "$runtime" "$cfg"
    if [ "$restart_desktop" = 1 ]; then
        echo "Restarting the desktop (labwc.service)"
        systemctl start labwc.service
    fi
}
trap cleanup EXIT

if [ "$KMS" = 1 ]; then
    if systemctl is-active -q labwc.service; then
        echo "Stopping the desktop (labwc.service) for the test"
        systemctl stop labwc.service
        restart_desktop=1
        sleep 1
    fi
    chvt 7 2>/dev/null
fi

# Same strategies as labwc-session (GPU strategies wait for the GPU after
# each frame, WLR_RENDERER_FINISH=1)
strategy_env() {
    local finish=" WLR_RENDERER_FINISH=1"
    case $1 in
    gles2)        echo "WLR_RENDERER=gles2 WLR_EGL_SKIP_DEVICE=1$finish" ;;
    gles2-render) echo "WLR_RENDERER=gles2 WLR_EGL_SKIP_DEVICE=1${render_node:+ WLR_RENDER_DRM_DEVICE=$render_node}$finish" ;;
    gles2-device) echo "WLR_RENDERER=gles2$finish" ;;
    pixman)       echo "WLR_RENDERER=pixman" ;;
    *)            return 1 ;;
    esac
}

echo "labwc-gpu-probe: mode $([ "$KMS" = 1 ] && echo "KMS (${kms_card:-no display device})" || echo "headless (${render_node:-no render node})")"
echo "labwc-gpu-probe: logs in $outdir"
echo

have_gdb=0
command -v gdb >/dev/null 2>&1 && have_gdb=1

declare -A result
for s in "${STRATEGIES[@]}"; do
    if ! envs=$(strategy_env "$s"); then
        echo "== $s: unknown strategy, skipped"
        result[$s]="unknown strategy"
        continue
    fi
    if [ "$KMS" = 1 ]; then
        backend_env="LIBSEAT_BACKEND=seatd WLR_BACKENDS=drm,libinput${kms_card:+ WLR_DRM_DEVICES=$kms_card}"
    else
        # Headless: the renderer runs on the GPU render node
        backend_env="WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1"
        case $s in gles2|gles2-device)
            [ -n "$render_node" ] && backend_env="$backend_env WLR_RENDER_DRM_DEVICE=$render_node" ;;
        esac
    fi
    log=$outdir/$s.log
    echo "== $s ($envs)"
    # Test clients: a white foot window (shared memory buffers, easy to tell
    # from a black screen) and GPU Test (OpenGL ES, buffers from the GPU via
    # wl_drm) for a few seconds, then exit labwc
    gl_client=
    command -v gpu-test >/dev/null 2>&1 && \
        gl_client="gpu-test --frames $((SECONDS_PER_TEST * 60)) > $outdir/$s-gpu-test.log 2>&1 &"
    startup="sh -c 'foot -o colors.background=ffffff -o colors.foreground=000000 -e sh -c \"echo labwc-gpu-probe: renderer $s; sleep $((SECONDS_PER_TEST - 2))\" & $gl_client sleep $SECONDS_PER_TEST; labwc --exit'"
    [ "$KMS" = 1 ] && echo "   watch the display: a white terminal window and the GPU Test molecule should appear for ${SECONDS_PER_TEST}s"
    cmd=(labwc -C "$cfg" -V -s "$startup")
    if [ "$have_gdb" = 1 ]; then
        cmd=(gdb -q -batch
             -ex "set pagination off" -ex "set confirm off"
             -ex "handle SIGTERM SIGINT SIGHUP SIGPIPE SIGCHLD SIGUSR1 SIGUSR2 nostop noprint pass"
             -ex run
             -ex "echo \n=== backtrace ===\n" -ex "thread apply all bt"
             -ex "echo \n=== registers ===\n" -ex "info registers pc lr sp"
             --args "${cmd[@]}")
    fi
    # shellcheck disable=SC2086
    env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root LANG=en_US.UTF-8 \
        XDG_RUNTIME_DIR="$runtime" WLR_LIBINPUT_NO_DEVICES=1 \
        $backend_env $envs \
        timeout -s KILL $((SECONDS_PER_TEST + 40)) "${cmd[@]}" > "$log" 2>&1
    rc=$?

    renderer_line=$(grep -m1 -E "Creating (GLES2|pixman) renderer|Using EGL" "$log")
    if grep -qE "Program received signal SIG(SEGV|ABRT|BUS|ILL|FPE|TRAP)" "$log"; then
        sig=$(grep -m1 -oE "Program received signal SIG[A-Z]+" "$log" | awk '{print $4}')
        result[$s]="CRASH ($sig)"
        echo "   -> CRASH: $sig. Last log lines and backtrace:"
        grep -vE "^\[New Thread|^\[Thread|^\[Inferior|libthread_db" "$log" \
            | sed -n '/=== backtrace ===/q;p' | tail -n 12 | sed 's/^/      /'
        sed -n '/=== backtrace ===/,$p' "$log" | head -n 60 | sed 's/^/      /'
    elif [ $rc -eq 137 ]; then
        result[$s]="HANG (killed after timeout)"
        echo "   -> HANG: labwc did not exit, killed"
    elif { [ "$have_gdb" = 1 ] && grep -q "exited normally" "$log"; } ||
         { [ "$have_gdb" = 0 ] && [ $rc -eq 0 ]; }; then
        errs=$(grep -cE "Failed to render|Failed to import|Failed to allocate|EGL_BAD_|GL_INVALID_|gbm_bo_create failed" "$log")
        if [ "$errs" -gt 0 ]; then
            result[$s]="RAN, $errs renderer errors"
            echo "   -> ran, but logged $errs renderer errors:"
            grep -m5 -E "Failed to render|Failed to import|Failed to allocate|EGL_BAD_|GL_INVALID_|gbm_bo_create failed" "$log" | sed 's/^/      /'
        else
            result[$s]="OK"
            echo "   -> OK${renderer_line:+: ${renderer_line#*] }}"
        fi
    else
        code=$(grep -m1 -oE "exited with code [0-9]+" "$log")
        result[$s]="FAILED (${code:-exit $rc})"
        echo "   -> FAILED (${code:-exit $rc}). Errors:"
        grep -E "\[ERROR\]|error|Failed|failed" "$log" | grep -v "^$" | tail -n 10 | sed 's/^/      /'
    fi
    # GPU Test's own report (did the OpenGL ES client start and render?)
    if [ -s "$outdir/$s-gpu-test.log" ]; then
        echo "   GPU Test: $(grep -m1 -E 'gpu-test: (OpenGL|could not|SDL|EGL|no access)' "$outdir/$s-gpu-test.log" || tail -n 1 "$outdir/$s-gpu-test.log")"
    fi
    # Only a person can tell whether the picture reached the display
    if [ "$KMS" = 1 ] && [ -t 0 ] && [[ ${result[$s]} == OK* || ${result[$s]} == RAN* ]]; then
        read -r -p "   Was the white terminal visible? [y/n] " seen
        case $seen in
        y*|Y*) result[$s]="${result[$s]}, terminal visible" ;;
        *)     result[$s]="${result[$s]}, terminal NOT visible" ;;
        esac
        if [ -n "$gl_client" ]; then
            read -r -p "   Was the rotating GPU Test molecule visible? [y/n] " seen
            case $seen in
            y*|Y*) result[$s]="${result[$s]}, GPU Test visible" ;;
            *)     result[$s]="${result[$s]}, GPU Test NOT visible" ;;
            esac
        fi
    fi
    echo
    sleep 1
done

echo "Summary ($([ "$KMS" = 1 ] && echo KMS || echo headless)):"
for s in "${STRATEGIES[@]}"; do
    printf '  %-14s %s\n' "$s" "${result[$s]}"
done
echo
echo "Full logs: $outdir (include them when reporting a problem)"
