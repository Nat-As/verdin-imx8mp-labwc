#!/bin/sh
# labwc session launcher used by labwc.service.
#
# Renderer selection
# ------------------
# labwc (wlroots) is started with the renderer strategies listed in
# LABWC_RENDERERS (/etc/default/labwc), in order, until one works:
#
#   gles2-render  GLES2 renderer on the GPU render node (/dev/dri/renderD128,
#                 Vivante); the default.
#   gles2         GLES2 renderer on the display device (EGL GBM platform on
#                 the imx-drm KMS node, like Weston; WLR_EGL_SKIP_DEVICE=1).
#                 With both, wlroots binds the display to EGL, which provides
#                 Vivante's wl_viv protocol for OpenGL ES applications.
#   gles2-device  GLES2 with wlroots' EGL device lookup (crashed in v0.0.3;
#                 only for diagnosis)
#   pixman        CPU software rendering (always works, slow)
#
# A strategy fails if labwc exits with an error, or logs renderer errors,
# within LABWC_FALLBACK_WINDOW seconds, or if it does not answer Wayland
# clients within LABWC_START_TIMEOUT seconds (a hanging GPU driver). A
# strategy that crashes labwc (signal) later is skipped until the next reboot
# as well. Setting WLR_RENDERER skips this and uses that renderer only.
#
# GPU strategies wait for the GPU to finish each frame before it is shown
# (WLR_RENDERER_FINISH=1): the Vivante driver does not provide the implicit
# fence that would make the display wait, so without it parts of the screen
# that are being redrawn can flash black. Disable with LABWC_RENDER_FINISH=0.
#
# The strategy in use is written to /tmp/labwc-session-<uid>/renderer
# (shown by labwc-hwaccel-check); every attempt is logged to the journal
# (journalctl -b -t labwc).

LABWC_RENDERERS=${LABWC_RENDERERS:-"gles2-render gles2 pixman"}
LABWC_FALLBACK_WINDOW=${LABWC_FALLBACK_WINDOW:-20}
LABWC_START_TIMEOUT=${LABWC_START_TIMEOUT:-45}
LABWC_RENDER_FINISH=${LABWC_RENDER_FINISH:-1}
# Renderer error lines within the window that make a strategy fail
LABWC_RENDER_ERROR_LIMIT=${LABWC_RENDER_ERROR_LIMIT:-5}
# Extra labwc arguments. Default -V (info level) so the journal shows which
# renderer wlroots created; use -d for full debug output.
LABWC_ARGS=${LABWC_ARGS--V}

RENDER_ERROR_RE='Failed to render|Failed to import|Failed to allocate|Failed to create (a )?(texture|render buffer|swapchain|allocator)|gbm_bo_create failed|EGL_BAD_|GL_INVALID_|GL_OUT_OF_MEMORY|Failed to (begin|submit|end) .*(render|command)'

log() { echo "labwc-session: $*"; }

# The image ships the en_US locale only (IMAGE_LINGUAS = "en-us"); C.UTF-8 is
# not installed, and foot needs a UTF-8 locale. The system default (LANG=C
# from systemd) is replaced, so applications started from the desktop get it.
case ${LANG:-} in
*UTF-8*|*utf8*) ;;
*) LANG=en_US.UTF-8 ;;
esac
export LANG
unset LC_ALL

# waybar and other GTK clients need a session bus. pam_systemd normally
# provides one at $XDG_RUNTIME_DIR/bus (user@.service + dbus.socket); if it
# is missing, run the whole session under dbus-run-session.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    elif command -v dbus-run-session >/dev/null 2>&1; then
        log "no user D-Bus found, starting one with dbus-run-session"
        exec dbus-run-session -- "$0" "$@"
    fi
fi

# Pure Wayland session: a stray DISPLAY (e.g. from a login shell) makes
# wlroots try its X11 backend, which is not built.
unset DISPLAY

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-labwc:wlroots}
export GDK_BACKEND=${GDK_BACKEND:-wayland}
export QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-wayland}
export SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-wayland}

# State that survives session restarts but not reboots (/tmp is a tmpfs)
STATE_DIR=/tmp/labwc-session-$(id -u)
mkdir -p "$STATE_DIR" && chmod 0755 "$STATE_DIR"
failed_file="$STATE_DIR/failed"
touch "$failed_file"
# Written once labwc answers Wayland clients; labwc-splash (labwc.service)
# ends the boot splash then
ready_file="$STATE_DIR/ready"
rm -f "$ready_file"

# First DRM render node (/dev/dri/renderD128: the Vivante GPU; the i.MX8MP
# display controller has none)
render_node() {
    for n in /sys/class/drm/renderD*; do
        [ -e "$n" ] && { echo "/dev/dri/${n##*/}"; return 0; }
    done
    return 1
}

# DRM card with display connectors (imx-drm; the Vivante card0 has none)
kms_card() {
    for c in /sys/class/drm/card[0-9]*; do
        case ${c##*/} in *-*) continue ;; esac
        for conn in "$c"-*; do
            [ -e "$conn" ] && { echo "/dev/dri/${c##*/}"; return 0; }
        done
    done
    return 1
}

# Use only the display controller as wlroots DRM backend device
if [ -z "$WLR_DRM_DEVICES" ] && card=$(kms_card); then
    export WLR_DRM_DEVICES=$card
    log "display device: $card"
fi

# Print the environment assignments for a strategy, or fail if unknown
strategy_env() {
    finish=
    [ "$LABWC_RENDER_FINISH" = 1 ] && finish=" WLR_RENDERER_FINISH=1"
    case $1 in
    gles2)        echo "WLR_RENDERER=gles2 WLR_EGL_SKIP_DEVICE=1$finish" ;;
    gles2-render)
        node=$(render_node) || return 1
        echo "WLR_RENDERER=gles2 WLR_EGL_SKIP_DEVICE=1 WLR_RENDER_DRM_DEVICE=$node$finish" ;;
    gles2-device) echo "WLR_RENDERER=gles2$finish" ;;
    pixman)       echo "WLR_RENDERER=pixman" ;;
    *)            return 1 ;;
    esac
}

# Copy labwc's output to the journal. During the first $LABWC_FALLBACK_WINDOW
# seconds, count renderer errors and stop labwc (pid $1) if there are too many.
watch_output() {
    pid=$1 marker=$2 start=$(date +%s) errors=0
    while IFS= read -r line; do
        printf '%s\n' "$line"
        if printf '%s\n' "$line" | grep -Eq "$RENDER_ERROR_RE"; then
            errors=$((errors + 1))
            if [ "$errors" -ge "$LABWC_RENDER_ERROR_LIMIT" ]; then
                log "$errors renderer errors, stopping labwc"
                echo "renderer errors" > "$marker"
                kill "$pid" 2>/dev/null
            fi
        fi
        [ $(( $(date +%s) - start )) -ge "$LABWC_FALLBACK_WINDOW" ] && break
    done
    exec cat
}

# Wait until labwc (pid $1) answers Wayland clients. Stop it if it does not
# within $LABWC_START_TIMEOUT seconds, e.g. because a GPU driver hangs.
# True if a compositor in $XDG_RUNTIME_DIR answers Wayland clients
labwc_answers() {
    for sock in "${XDG_RUNTIME_DIR:-/tmp}"/wayland-*; do
        case $sock in *.lock) continue ;; esac
        [ -S "$sock" ] || continue
        WAYLAND_DISPLAY=${sock##*/} timeout 5 wlr-randr >/dev/null 2>&1 && return 0
    done
    return 1
}

watch_startup() {
    pid=$1 marker=$2 t=0
    while [ "$t" -lt "$LABWC_START_TIMEOUT" ]; do
        kill -0 "$pid" 2>/dev/null || return 0
        if labwc_answers; then
            log "labwc is up after ${t}s"
            : > "$ready_file"
            return 0
        fi
        sleep 1
        t=$((t + 1))
    done
    log "labwc did not start within ${LABWC_START_TIMEOUT}s, stopping it"
    echo "no response from labwc" > "$marker"
    kill "$pid" 2>/dev/null
    sleep 3
    kill -9 "$pid" 2>/dev/null
}

# Run labwc with a strategy. Returns 0 if labwc ended normally, 1 if the
# strategy failed (and labwc should be tried with the next one), 2 if labwc
# failed after it had been running for a while.
run_strategy() {
    name=$1 envs=$2
    shift 2
    fifo="$STATE_DIR/output.$$" marker="$STATE_DIR/marker.$$"
    rm -f "$fifo" "$marker"
    mkfifo "$fifo" || return 1

    log "starting labwc with renderer strategy '$name' ($envs)"
    echo "$name" > "$STATE_DIR/renderer"
    start=$(date +%s)
    # shellcheck disable=SC2086
    env $envs labwc $LABWC_ARGS "$@" > "$fifo" 2>&1 &
    pid=$!
    watch_output "$pid" "$marker" < "$fifo" &
    watcher=$!
    watch_startup "$pid" "$marker" &
    starter=$!
    # Stop labwc when systemd stops the session
    trap 'kill $pid 2>/dev/null' TERM INT HUP
    wait "$pid"
    rc=$?
    # wait returns early when a trapped signal arrives
    while kill -0 "$pid" 2>/dev/null; do wait "$pid"; rc=$?; done
    trap - TERM INT HUP
    elapsed=$(( $(date +%s) - start ))
    sleep 0.2
    kill "$watcher" "$starter" 2>/dev/null
    rm -f "$fifo"

    if [ -e "$marker" ]; then
        log "strategy '$name' failed: $(cat "$marker") within ${elapsed}s"
        rm -f "$marker"
        return 1
    fi
    if [ "$rc" -eq 0 ]; then
        log "labwc exited normally after ${elapsed}s"
        return 0
    fi
    if [ "$rc" -gt 128 ]; then
        reason="killed by signal $((rc - 128))"
    else
        reason="exit code $rc"
    fi
    if [ "$elapsed" -lt "$LABWC_FALLBACK_WINDOW" ]; then
        log "strategy '$name' failed: labwc $reason after ${elapsed}s"
        return 1
    fi
    log "labwc $reason after ${elapsed}s with strategy '$name'"
    # A crash after startup: don't use this strategy again until reboot
    [ "$rc" -gt 128 ] && return 3
    return 2
}

if [ -n "$WLR_RENDERER" ]; then
    log "using WLR_RENDERER=$WLR_RENDERER (forced in /etc/default/labwc)"
    echo "$WLR_RENDERER (forced)" > "$STATE_DIR/renderer"
    # Report when labwc is up (for the boot splash); no fallback here
    (
        t=0
        while [ "$t" -lt 240 ]; do
            labwc_answers && { : > "$ready_file"; exit 0; }
            sleep 0.5
            t=$((t + 1))
        done
    ) &
    exec labwc $LABWC_ARGS "$@"
fi

for s in $LABWC_RENDERERS; do
    if grep -qx "$s" "$failed_file"; then
        log "skipping strategy '$s' (failed earlier in this boot)"
        continue
    fi
    if ! envs=$(strategy_env "$s"); then
        log "skipping unknown or unavailable strategy '$s'"
        continue
    fi
    run_strategy "$s" "$envs" "$@"
    rc=$?
    case $rc in
    0) exit 0 ;;
    2) exit 1 ;;
    esac
    [ "$s" != pixman ] && echo "$s" >> "$failed_file"
    # Crash after startup: systemd restarts the service, which then skips it
    [ "$rc" -eq 3 ] && exit 1
done

log "all renderer strategies failed, using pixman"
echo "pixman (last resort)" > "$STATE_DIR/renderer"
exec env WLR_RENDERER=pixman labwc $LABWC_ARGS "$@"
