# labwc autostart (system default). Runs once when the session starts.
# Per-user override: ~/.config/labwc/autostart

# Wallpaper first: until it draws, the screen is black (right after the boot
# splash). Falls back to a solid colour if the image is missing.
if [ -f /usr/share/backgrounds/labwc-demo/wallpaper.png ]; then
	swaybg -m fill -i /usr/share/backgrounds/labwc-demo/wallpaper.png >/dev/null 2>&1 &
else
	swaybg -c '#1d3557' >/dev/null 2>&1 &
fi

# Panel
waybar >/dev/null 2>&1 &

# Turn off the 7" DSI panel output if the panel is not connected
labwc-demo-outputs

# Remote desktop mirror of the touch screen (or the first output), as in the
# kiosk session
if command -v argos-remote-session >/dev/null 2>&1; then
	systemd-cat -t argos-remote argos-remote-session kiosk "$(/usr/libexec/labwc-demo/labwc-kiosk --output)" &
fi
