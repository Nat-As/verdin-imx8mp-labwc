# System unit that starts labwc on tty1 as the unprivileged desktop user
# (@DESKTOP_USER@, see LABWC_DEMO_DESKTOP_USER).
#
# Seat/device access: seatd (seatd.service, socket group "video") opens the
# DRM and input devices for the compositor via libseat, so labwc does not
# need root. PAM (pam_systemd) still creates a logind session for the user,
# which provides XDG_RUNTIME_DIR and the user D-Bus session bus.
#
# logind is deliberately not used as the libseat backend: on this distro
# logind authorises Session.Activate via polkit, and the image ships no
# polkit daemon (see meta-labwc-demo/recipes-core/seatd).
#
# Boot splash handoff (Plymouth, theme argos): labwc runs on tty1, the VT
# Plymouth draws on, so there is no VT switch between splash and desktop.
# Like GDM, it conflicts with plymouth-quit.service: instead of Plymouth
# quitting (and clearing the screen) on its own, labwc-splash deactivates
# Plymouth right before labwc starts (Plymouth releases the display, its last
# frame stays visible) and quits it once labwc answers Wayland clients.
[Unit]
Description=labwc Wayland compositor (autologin session for user @DESKTOP_USER@)
Documentation=man:labwc(1) https://labwc.github.io/

# Start after logins are permitted.
Requires=systemd-user-sessions.service
After=systemd-user-sessions.service

# Boot splash: take over from Plymouth (see above); tty1 is ours.
After=plymouth-start.service plymouth-quit.service getty@tty1.service
Conflicts=plymouth-quit.service getty@tty1.service
OnFailure=plymouth-quit.service

# Seat management.
Requires=seatd.service
After=seatd.service

# D-Bus and logind are needed for the user session.
Wants=dbus.socket
After=dbus.socket systemd-logind.service

# Part of the graphical session.
Before=graphical.target

# A virtual terminal is required.
ConditionPathExists=/dev/tty0

# Give up (and quit the boot splash) if labwc keeps failing.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
Environment=LIBSEAT_BACKEND=seatd
# Start even when no keyboard/mouse/touchscreen is connected yet (wlroots
# otherwise refuses to start); hotplugged input devices still work.
Environment=WLR_LIBINPUT_NO_DEVICES=1
EnvironmentFile=-/etc/default/labwc

# Wait for the display (and GPU, if present) DRM devices, as Toradex's
# weston.service does.
ExecStartPre=-/usr/bin/udevadm wait --timeout=30 /dev/dri/card0
ExecStartPre=-/bin/sh -c "ls /dev/dri/by-path/*gpu* >/dev/null 2>&1 && /usr/bin/udevadm wait --timeout=30 /dev/dri/card1"
# seatd binds the compositor to the VT that is active when it connects, so
# bring tty1 to the foreground first ("+" = run as root). Then let Plymouth
# release the display (see above).
ExecStartPre=+/usr/bin/chvt 1
ExecStartPre=-+/usr/libexec/labwc-demo/labwc-splash deactivate @DESKTOP_USER@

ExecStart=/usr/bin/labwc-session

# End the boot splash once the desktop is up (waits at most 60 s)
ExecStartPost=-+/usr/libexec/labwc-demo/labwc-splash quit-when-ready @DESKTOP_USER@

# Text console on tty2 when the session ends or fails (Ctrl+Alt+F2)
ExecStopPost=+/usr/bin/chvt 2

User=@DESKTOP_USER@
Group=@DESKTOP_USER@
WorkingDirectory=~

# Full user session (XDG_RUNTIME_DIR, logind session, user D-Bus).
PAMName=labwc-autologin

# A virtual terminal is needed. It is not reset, hung up or cleared: writing
# to it would make the kernel's framebuffer console take over the display
# and replace the splash with a black text screen.
TTYPath=/dev/tty1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no

# Fail to start if not controlling the tty.
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
# The PAM session moves the processes into the user's session, so filter the
# compositor log by identifier: journalctl -b -t labwc
SyslogIdentifier=labwc

# Show up in 'w' and 'who'.
UtmpIdentifier=tty1
UtmpMode=user

# Also restart after "Exit" from the menu; stop with: systemctl stop labwc
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
