# Environment for labwc.service (read by systemd, then by labwc-session).
# Apply changes with: sudo systemctl restart labwc
#
# Renderer: labwc-session tries these renderer strategies in order and falls
# back to the next one if labwc crashes, hangs or logs renderer errors during
# startup (see /usr/bin/labwc-session):
#   gles2         OpenGL ES 2 renderer on the display device (as Weston does)
#   gles2-render  OpenGL ES 2 renderer on the GPU render node
#   pixman        software rendering on the CPU (slow, always works)
#   Vulkan strategies (EXPERIMENTAL, not used by default):
#   vulkan-auto   picks one of the following with vk-scanout-test, or none
#   vulkan-buffer renders off-screen, copies into display memory through a
#                 VkBuffer (for drivers that write images tiled, like Vivante)
#   vulkan-copy   renders off-screen, copies with vkCmdCopyImage
#   vulkan        renders into the display buffers directly (black screen on
#                 the i.MX8MP)
#   vulkan-noforeign  vulkan without queue ownership transfers
# Default order:
#LABWC_RENDERERS="gles2 gles2-render pixman"
# To try Vulkan first:
#LABWC_RENDERERS="vulkan-auto gles2 pixman"
# Check which one is in use with labwc-hwaccel-check, and which ones show a
# picture with: sudo labwc-gpu-probe --kms
#
# Or force a single wlroots renderer (no fallback): gles2, vulkan or pixman.
#WLR_RENDERER=pixman
#
# Seconds after startup during which a failure moves on to the next strategy
#LABWC_FALLBACK_WINDOW=20
#
# Seconds labwc may take to start answering clients before the next strategy
# is tried (protects against a GPU driver that hangs)
#LABWC_START_TIMEOUT=45

# Seat backend (set by labwc.service): seatd. logind needs polkit, which
# this image does not ship.
#LIBSEAT_BACKEND=seatd

# Uncomment if the cursor is invisible or corrupted on your display.
#WLR_NO_HARDWARE_CURSORS=1

# DRM display device (default: detected, the card with display connectors)
#WLR_DRM_DEVICES=/dev/dri/card1

# Session locale (default en_US.UTF-8, the only locale in the image)
#LANG=en_US.UTF-8

# labwc arguments (default: -V). Use -d for debug logging.
#LABWC_ARGS=-d

# Keyboard layout (also settable in /etc/xdg/labwc/environment).
#XKB_DEFAULT_LAYOUT=us
