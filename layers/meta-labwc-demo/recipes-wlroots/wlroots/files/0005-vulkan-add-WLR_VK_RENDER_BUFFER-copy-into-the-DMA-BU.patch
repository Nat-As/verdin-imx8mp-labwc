From 1c9374b2a7da59dc534ab7a1e82d8a8f0b485f1a Mon Sep 17 00:00:00 2001
From: Nat-As <42288915+Nat-As@users.noreply.github.com>
Date: Wed, 21 Oct 2026 13:27:19 -0400
Subject: [PATCH] vulkan: add WLR_VK_RENDER_BUFFER: copy into the DMA-BUF
 through a VkBuffer

Some drivers (Vivante VSI on i.MX8M Plus) write images in imported
DMA-BUF memory in their own tiled layout, regardless of the LINEAR
modifier. The display then shows scrambled pixels, or black. With
WLR_VK_RENDER_BUFFER, the renderer renders into an optimal-tiling image
(as with WLR_VK_RENDER_COPY). It binds the DMA-BUF's memory to a
VkBuffer and copies the updated region into it with
vkCmdCopyImageToBuffer, using the DMA-BUF's offset and stride, so the
data is linear. read_pixels reads from the copy image.
---
 include/render/vulkan.h  |  11 ++++
 render/vulkan/pass.c     |  47 ++++++++++++++--
 render/vulkan/renderer.c | 112 +++++++++++++++++++++++++++++++++++++--
 3 files changed, 163 insertions(+), 7 deletions(-)

diff --git a/include/render/vulkan.h b/include/render/vulkan.h
index f5e70b6..9b877ed 100644
--- a/include/render/vulkan.h
+++ b/include/render/vulkan.h
@@ -218,6 +218,13 @@ struct wlr_vk_render_buffer {
 	VkImageView copy_image_view;
 	VkDeviceMemory copy_memory;
 	bool copy_transitioned;
+
+	// WLR_VK_RENDER_BUFFER: the DMA-BUF's memory bound to a buffer; the copy
+	// image is copied into it with vkCmdCopyImageToBuffer, so the data lands
+	// in the DMA-BUF in the linear layout given by its stride
+	VkBuffer dmabuf_buffer;
+	VkDeviceMemory dmabuf_buffer_memory;
+	uint32_t dmabuf_offset, dmabuf_stride, dmabuf_bpp;
 };
 
 struct wlr_vk_command_buffer {
@@ -244,6 +251,10 @@ struct wlr_vk_renderer {
 	// Driver workarounds, set from the environment:
 	// WLR_VK_RENDER_COPY: don't render into DMA-BUF images directly
 	bool render_copy;
+	// WLR_VK_RENDER_BUFFER: like render_copy, but copy into the DMA-BUF
+	// through a VkBuffer, for drivers that write images in imported
+	// memory in their own (tiled) layout regardless of the modifier
+	bool render_to_buffer;
 	// WLR_VK_NO_FOREIGN: no queue family ownership transfers for the
 	// render buffer
 	bool no_foreign;
diff --git a/render/vulkan/pass.c b/render/vulkan/pass.c
index 6d6f828..f340058 100644
--- a/render/vulkan/pass.c
+++ b/render/vulkan/pass.c
@@ -153,9 +153,23 @@ static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 				.subresourceRange.levelCount = 1,
 			},
 		};
+		// WLR_VK_RENDER_BUFFER: the destination is the DMA-BUF buffer,
+		// not the DMA-BUF image
+		VkBufferMemoryBarrier dmabuf_buffer_barrier = {
+			.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER,
+			.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+			.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+			.buffer = render_buffer->dmabuf_buffer,
+			.size = VK_WHOLE_SIZE,
+			.srcAccessMask = 0,
+			.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+		};
+		bool to_buffer = render_buffer->dmabuf_buffer != VK_NULL_HANDLE;
 		vkCmdPipelineBarrier(render_cb->vk,
 			VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
-			VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 2, copy_barriers);
+			VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL,
+			to_buffer ? 1 : 0, &dmabuf_buffer_barrier,
+			to_buffer ? 1 : 2, copy_barriers);
 
 		int width = render_buffer->wlr_buffer->width;
 		int height = render_buffer->wlr_buffer->height;
@@ -163,8 +177,12 @@ static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 		int rects_len;
 		const pixman_box32_t *rects = pixman_region32_rectangles(updated, &rects_len);
 		VkImageCopy *regions = calloc(rects_len > 0 ? rects_len : 1, sizeof(*regions));
-		if (regions == NULL) {
+		VkBufferImageCopy *buf_regions = calloc(rects_len > 0 ? rects_len : 1,
+			sizeof(*buf_regions));
+		if (regions == NULL || buf_regions == NULL) {
 			wlr_log_errno(WLR_ERROR, "Allocation failed");
+			free(regions);
+			free(buf_regions);
 			goto error;
 		}
 		int regions_len = 0;
@@ -176,6 +194,19 @@ static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 			if (x2 <= x1 || y2 <= y1) {
 				continue;
 			}
+			buf_regions[regions_len] = (VkBufferImageCopy){
+				.bufferOffset = render_buffer->dmabuf_offset +
+					(VkDeviceSize)y1 * render_buffer->dmabuf_stride +
+					(VkDeviceSize)x1 * render_buffer->dmabuf_bpp,
+				.bufferRowLength = to_buffer ?
+					render_buffer->dmabuf_stride / render_buffer->dmabuf_bpp : 0,
+				.imageSubresource = {
+					.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+					.layerCount = 1,
+				},
+				.imageOffset = { x1, y1, 0 },
+				.imageExtent = { x2 - x1, y2 - y1, 1 },
+			};
 			regions[regions_len++] = (VkImageCopy){
 				.srcSubresource = {
 					.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
@@ -190,13 +221,23 @@ static bool render_pass_submit(struct wlr_render_pass *wlr_pass) {
 				.extent = { x2 - x1, y2 - y1, 1 },
 			};
 		}
-		if (regions_len > 0) {
+		if (regions_len > 0 && to_buffer) {
+			vkCmdCopyImageToBuffer(render_cb->vk,
+				render_buffer->copy_image, VK_IMAGE_LAYOUT_GENERAL,
+				render_buffer->dmabuf_buffer, regions_len, buf_regions);
+			dmabuf_buffer_barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+			dmabuf_buffer_barrier.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT;
+			vkCmdPipelineBarrier(render_cb->vk, VK_PIPELINE_STAGE_TRANSFER_BIT,
+				VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0, 0, NULL,
+				1, &dmabuf_buffer_barrier, 0, NULL);
+		} else if (regions_len > 0) {
 			vkCmdCopyImage(render_cb->vk,
 				render_buffer->copy_image, VK_IMAGE_LAYOUT_GENERAL,
 				render_buffer->image, VK_IMAGE_LAYOUT_GENERAL,
 				regions_len, regions);
 		}
 		free(regions);
+		free(buf_regions);
 	}
 
 	// insert acquire and release barriers for dmabuf-images
diff --git a/render/vulkan/renderer.c b/render/vulkan/renderer.c
index 1d30f20..0374b87 100644
--- a/render/vulkan/renderer.c
+++ b/render/vulkan/renderer.c
@@ -615,6 +615,8 @@ static void destroy_render_buffer(struct wlr_vk_render_buffer *buffer) {
 	vkDestroyImageView(dev, buffer->copy_image_view, NULL);
 	vkDestroyImage(dev, buffer->copy_image, NULL);
 	vkFreeMemory(dev, buffer->copy_memory, NULL);
+	vkDestroyBuffer(dev, buffer->dmabuf_buffer, NULL);
+	vkFreeMemory(dev, buffer->dmabuf_buffer_memory, NULL);
 
 	free(buffer);
 }
@@ -816,6 +818,95 @@ static bool setup_copy_image(struct wlr_vk_renderer *renderer,
 	return true;
 }
 
+// WLR_VK_RENDER_BUFFER: bind the (single-plane) DMA-BUF's memory to a
+// VkBuffer that the copy image is copied into
+static bool setup_dmabuf_buffer(struct wlr_vk_renderer *renderer,
+		struct wlr_vk_render_buffer *buffer, const struct wlr_dmabuf_attributes *dmabuf) {
+	VkResult res;
+	VkDevice dev = renderer->dev->dev;
+
+	const struct wlr_pixel_format_info *info = drm_get_pixel_format_info(dmabuf->format);
+	if (dmabuf->n_planes != 1 || info == NULL ||
+			pixel_format_info_pixels_per_block(info) != 1 ||
+			dmabuf->stride[0] % info->bytes_per_block != 0) {
+		wlr_log(WLR_ERROR, "WLR_VK_RENDER_BUFFER: unsupported DMA-BUF layout");
+		return false;
+	}
+	buffer->dmabuf_offset = dmabuf->offset[0];
+	buffer->dmabuf_stride = dmabuf->stride[0];
+	buffer->dmabuf_bpp = info->bytes_per_block;
+
+	VkExternalMemoryBufferCreateInfo ext_info = {
+		.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+		.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+	};
+	VkBufferCreateInfo buf_info = {
+		.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+		.pNext = &ext_info,
+		.size = (VkDeviceSize)dmabuf->offset[0] +
+			(VkDeviceSize)dmabuf->stride[0] * dmabuf->height,
+		.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+		.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+	};
+	res = vkCreateBuffer(dev, &buf_info, NULL, &buffer->dmabuf_buffer);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkCreateBuffer (DMA-BUF buffer)", res);
+		return false;
+	}
+
+	VkMemoryFdPropertiesKHR fdp = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+	};
+	res = renderer->dev->api.vkGetMemoryFdPropertiesKHR(dev,
+		VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, dmabuf->fd[0], &fdp);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkGetMemoryFdPropertiesKHR", res);
+		return false;
+	}
+	VkMemoryRequirements mem_reqs;
+	vkGetBufferMemoryRequirements(dev, buffer->dmabuf_buffer, &mem_reqs);
+	int mem_type = vulkan_find_mem_type(renderer->dev, 0,
+		mem_reqs.memoryTypeBits & fdp.memoryTypeBits);
+	if (mem_type < 0) {
+		wlr_log(WLR_ERROR, "no valid memory type index for the DMA-BUF buffer");
+		return false;
+	}
+
+	int dfd = fcntl(dmabuf->fd[0], F_DUPFD_CLOEXEC, 0);
+	if (dfd < 0) {
+		wlr_log_errno(WLR_ERROR, "fcntl(F_DUPFD_CLOEXEC) failed");
+		return false;
+	}
+	VkMemoryDedicatedAllocateInfo dedicated = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+		.buffer = buffer->dmabuf_buffer,
+	};
+	VkImportMemoryFdInfoKHR import = {
+		.sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+		.pNext = &dedicated,
+		.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+		.fd = dfd,
+	};
+	VkMemoryAllocateInfo mem_info = {
+		.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		.pNext = &import,
+		.allocationSize = mem_reqs.size,
+		.memoryTypeIndex = mem_type,
+	};
+	res = vkAllocateMemory(dev, &mem_info, NULL, &buffer->dmabuf_buffer_memory);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkAllocateMemory (DMA-BUF buffer import)", res);
+		close(dfd);
+		return false;
+	}
+	res = vkBindBufferMemory(dev, buffer->dmabuf_buffer, buffer->dmabuf_buffer_memory, 0);
+	if (res != VK_SUCCESS) {
+		wlr_vk_error("vkBindBufferMemory (DMA-BUF buffer)", res);
+		return false;
+	}
+	return true;
+}
+
 static struct wlr_vk_render_buffer *create_render_buffer(
 		struct wlr_vk_renderer *renderer, struct wlr_buffer *wlr_buffer) {
 	VkResult res;
@@ -897,6 +988,10 @@ static struct wlr_vk_render_buffer *create_render_buffer(
 				dmabuf.width, dmabuf.height)) {
 			goto error;
 		}
+		if (renderer->render_to_buffer &&
+				!setup_dmabuf_buffer(renderer, buffer, &dmabuf)) {
+			goto error;
+		}
 		attachments[attachment_count++] = buffer->copy_image_view;
 	} else {
 		attachments[attachment_count++] = buffer->image_view;
@@ -937,6 +1032,8 @@ error:
 	vkDestroyImageView(dev, buffer->copy_image_view, NULL);
 	vkDestroyImage(dev, buffer->copy_image, NULL);
 	vkFreeMemory(dev, buffer->copy_memory, NULL);
+	vkDestroyBuffer(dev, buffer->dmabuf_buffer, NULL);
+	vkFreeMemory(dev, buffer->dmabuf_buffer_memory, NULL);
 
 	vkDestroyFramebuffer(dev, buffer->framebuffer, NULL);
 	vkDestroyImageView(dev, buffer->image_view, NULL);
@@ -1779,7 +1876,11 @@ static bool vulkan_read_pixels(struct wlr_renderer *wlr_renderer,
 		uint32_t dst_x, uint32_t dst_y, void *data) {
 	struct wlr_vk_renderer *vk_renderer = vulkan_get_renderer(wlr_renderer);
 	VkDevice dev = vk_renderer->dev->dev;
-	VkImage src_image = vk_renderer->current_render_buffer->image;
+	// In the copy modes, the copy image holds the rendered content (the
+	// DMA-BUF image may not be readable as an image on such drivers)
+	VkImage src_image = vk_renderer->current_render_buffer->copy_image ?
+		vk_renderer->current_render_buffer->copy_image :
+		vk_renderer->current_render_buffer->image;
 
 	const struct wlr_pixel_format_info *pixel_format_info = drm_get_pixel_format_info(drm_format);
 	if (!pixel_format_info) {
@@ -2874,11 +2975,14 @@ struct wlr_renderer *vulkan_renderer_create_for_device(struct wlr_vk_device *dev
 	}
 
 	renderer->dev = dev;
-	renderer->render_copy = env_parse_bool("WLR_VK_RENDER_COPY");
+	renderer->render_to_buffer = env_parse_bool("WLR_VK_RENDER_BUFFER");
+	renderer->render_copy = env_parse_bool("WLR_VK_RENDER_COPY") ||
+		renderer->render_to_buffer;
 	renderer->no_foreign = env_parse_bool("WLR_VK_NO_FOREIGN");
 	renderer->finish = env_parse_bool("WLR_RENDERER_FINISH");
-	wlr_log(WLR_INFO, "Vulkan renderer options: render-copy=%d no-foreign=%d finish=%d",
-		renderer->render_copy, renderer->no_foreign, renderer->finish);
+	wlr_log(WLR_INFO, "Vulkan renderer options: render-copy=%d render-buffer=%d "
+		"no-foreign=%d finish=%d", renderer->render_copy, renderer->render_to_buffer,
+		renderer->no_foreign, renderer->finish);
 	wlr_renderer_init(&renderer->wlr_renderer, &renderer_impl);
 	wl_list_init(&renderer->stage.buffers);
 	wl_list_init(&renderer->foreign_textures);
-- 
2.34.1

