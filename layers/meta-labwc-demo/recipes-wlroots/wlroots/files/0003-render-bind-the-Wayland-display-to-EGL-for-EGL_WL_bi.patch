 		struct wlr_buffer *buffer) {
 	struct wlr_gles2_renderer *renderer = gles2_get_renderer(wlr_renderer);
@@ -357,8 +445,11 @@ struct wlr_texture *gles2_texture_from_buffer(struct wlr_renderer *wlr_renderer,
 	uint32_t format;
 	size_t stride;
 	struct wlr_dmabuf_attributes dmabuf;
+	struct wlr_gles2_wl_buffer *wl_buffer;
 	if (wlr_buffer_get_dmabuf(buffer, &dmabuf)) {
 		return gles2_texture_from_dmabuf_buffer(renderer, buffer, &dmabuf);
+	} else if ((wl_buffer = gles2_wl_buffer_try_from_buffer(buffer)) != NULL) {
+		return gles2_texture_from_wl_buffer(renderer, wl_buffer);
 	} else if (wlr_buffer_begin_data_ptr_access(buffer,
 			WLR_BUFFER_DATA_PTR_ACCESS_READ, &data, &format, &stride)) {
 		struct wlr_texture *tex = gles2_texture_from_pixels(wlr_renderer,
diff --git a/render/gles2/wl_buffer.c b/render/gles2/wl_buffer.c
new file mode 100644
index 0000000..9be3ddd
--- /dev/null
+++ b/render/gles2/wl_buffer.c
@@ -0,0 +1,146 @@
+#include <assert.h>
+#include <stdlib.h>
+#include <wayland-server-core.h>
+#include <wayland-server-protocol.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/util/log.h>
+#include "render/egl.h"
+#include "render/gles2.h"
+#include "types/wlr_buffer.h"
+#include "util/env.h"
+
+/*
+ * wl_buffers created by the EGL implementation's own Wayland protocol, which
+ * the compositor provides by binding its display with
+ * EGL_WL_bind_wayland_display. The Vivante (i.MX) EGL needs this: its clients
+ * only present through wl_viv, not through linux-dmabuf.
+ */
+
+// The EGL display bound to the Wayland display; there is one per compositor
+static struct wlr_egl *bound_egl = NULL;
+
+static const struct wlr_buffer_impl buffer_impl;
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_gles2_wl_buffer *buffer =
+		gles2_wl_buffer_try_from_buffer(wlr_buffer);
+	assert(buffer != NULL);
+	if (buffer->resource != NULL) {
+		wl_list_remove(&buffer->resource_destroy.link);
+	}
+	wl_list_remove(&buffer->release.link);
+	free(buffer);
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+};
+
+struct wlr_gles2_wl_buffer *gles2_wl_buffer_try_from_buffer(
+		struct wlr_buffer *wlr_buffer) {
+	if (wlr_buffer->impl != &buffer_impl) {
+		return NULL;
+	}
+	struct wlr_gles2_wl_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+	return buffer;
+}
+
+static void buffer_handle_resource_destroy(struct wl_listener *listener,
+		void *data) {
+	struct wlr_gles2_wl_buffer *buffer =
+		wl_container_of(listener, buffer, resource_destroy);
+	wl_list_remove(&buffer->resource_destroy.link);
+	buffer->resource = NULL;
+	wlr_buffer_drop(&buffer->base);
+}
+
+static void buffer_handle_release(struct wl_listener *listener, void *data) {
+	struct wlr_gles2_wl_buffer *buffer =
+		wl_container_of(listener, buffer, release);
+	if (buffer->resource != NULL) {
+		wl_buffer_send_release(buffer->resource);
+	}
+}
+
+static bool buffer_resource_is_instance(struct wl_resource *resource) {
+	EGLint format;
+	return bound_egl != NULL && wlr_egl_query_wayland_buffer(bound_egl,
+		resource, EGL_TEXTURE_FORMAT, &format);
+}
+
+static struct wlr_buffer *buffer_from_resource(struct wl_resource *resource) {
+	struct wl_listener *listener = wl_resource_get_destroy_listener(resource,
+		buffer_handle_resource_destroy);
+	if (listener != NULL) {
+		struct wlr_gles2_wl_buffer *buffer =
+			wl_container_of(listener, buffer, resource_destroy);
+		return &buffer->base;
+	}
+
+	EGLint width, height, format, y_inverted;
+	if (!wlr_egl_query_wayland_buffer(bound_egl, resource, EGL_WIDTH, &width) ||
+			!wlr_egl_query_wayland_buffer(bound_egl, resource, EGL_HEIGHT, &height) ||
+			!wlr_egl_query_wayland_buffer(bound_egl, resource,
+				EGL_TEXTURE_FORMAT, &format)) {
+		wlr_log(WLR_ERROR, "eglQueryWaylandBufferWL failed");
+		return NULL;
+	}
+	// Like Weston: assume the origin is at the top left if the query fails
+	if (!wlr_egl_query_wayland_buffer(bound_egl, resource,
+			EGL_WAYLAND_Y_INVERTED_WL, &y_inverted)) {
+		y_inverted = EGL_TRUE;
+	}
+
+	struct wlr_gles2_wl_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &buffer_impl, width, height);
+	buffer->resource = resource;
+	buffer->texture_format = format;
+	buffer->y_inverted = y_inverted;
+
+	buffer->resource_destroy.notify = buffer_handle_resource_destroy;
+	wl_resource_add_destroy_listener(resource, &buffer->resource_destroy);
+
+	buffer->release.notify = buffer_handle_release;
+	wl_signal_add(&buffer->base.events.release, &buffer->release);
+
+	wlr_log(WLR_DEBUG, "EGL Wayland buffer %dx%d, texture format 0x%04X%s",
+		width, height, format, y_inverted ? "" : ", origin at the bottom left");
+	return &buffer->base;
+}
+
+static const struct wlr_buffer_resource_interface buffer_resource_interface = {
+	.name = "wlr_gles2_wl_buffer",
+	.is_instance = buffer_resource_is_instance,
+	.from_resource = buffer_from_resource,
+};
+
+bool gles2_renderer_bind_wl_display(struct wlr_renderer *wlr_renderer,
+		struct wl_display *wl_display) {
+	struct wlr_gles2_renderer *renderer = gles2_get_renderer(wlr_renderer);
+	if (env_parse_bool("WLR_EGL_NO_BIND_DISPLAY")) {
+		wlr_log(WLR_INFO, "WLR_EGL_NO_BIND_DISPLAY set: not binding the "
+			"Wayland display to EGL");
+		return false;
+	}
+	if (bound_egl != NULL ||
+			!wlr_egl_bind_wayland_display(renderer->egl, wl_display)) {
+		return false;
+	}
+	bound_egl = renderer->egl;
+	wlr_buffer_set_fallback_resource_interface(&buffer_resource_interface);
+	wlr_log(WLR_INFO, "Bound the Wayland display to EGL "
+		"(EGL_WL_bind_wayland_display): EGL clients can present");
+	return true;
+}
+
+void gles2_renderer_unbind_wl_display(struct wlr_gles2_renderer *renderer) {
+	if (bound_egl == renderer->egl) {
+		bound_egl = NULL;
+		wlr_buffer_set_fallback_resource_interface(NULL);
+	}
+}
