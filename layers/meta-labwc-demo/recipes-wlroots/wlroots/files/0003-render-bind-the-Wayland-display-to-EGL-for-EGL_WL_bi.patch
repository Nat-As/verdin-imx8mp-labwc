+bool wlr_egl_bind_wayland_display(struct wlr_egl *egl,
+		struct wl_display *wl_display) {
+	if (!egl->exts.WL_bind_wayland_display || !egl->exts.KHR_image_base) {
+		return false;
+	}
+	if (!egl->procs.eglBindWaylandDisplayWL(egl->display, wl_display)) {
+		wlr_log(WLR_ERROR, "eglBindWaylandDisplayWL failed");
+		return false;
+	}
+	egl->wl_display = wl_display;
+	return true;
+}
+
+bool wlr_egl_query_wayland_buffer(struct wlr_egl *egl,
+		struct wl_resource *buffer, EGLint attrib, EGLint *value) {
+	if (egl->wl_display == NULL) {
+		return false;
+	}
+	return egl->procs.eglQueryWaylandBufferWL(egl->display, buffer,
+		attrib, value);
+}
+
+EGLImageKHR wlr_egl_create_image_from_wl_buffer(struct wlr_egl *egl,
+		struct wl_resource *buffer) {
+	if (egl->wl_display == NULL) {
+		return EGL_NO_IMAGE_KHR;
+	}
+	const EGLint attribs[] = {
+		EGL_WAYLAND_PLANE_WL, 0,
+		EGL_IMAGE_PRESERVED_KHR, EGL_TRUE,
+		EGL_NONE,
+	};
+	EGLImageKHR image = egl->procs.eglCreateImageKHR(egl->display,
+		EGL_NO_CONTEXT, EGL_WAYLAND_BUFFER_WL, buffer, attribs);
+	if (image == EGL_NO_IMAGE_KHR) {
+		wlr_log(WLR_ERROR, "eglCreateImageKHR failed for a Wayland buffer");
+	}
+	return image;
+}
