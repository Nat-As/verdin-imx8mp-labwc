+ * wl_viv, wl_drm). Returns false if the extension is missing or fails.
+ */
+bool wlr_egl_bind_wayland_display(struct wlr_egl *egl,
+	struct wl_display *wl_display);
+
+/**
+ * Queries an attribute of a wl_buffer created by the EGL implementation.
