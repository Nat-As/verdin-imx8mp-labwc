<Project Sdk="Microsoft.NET.Sdk">
  <!-- opencv-cs-check: OpenCV from C# (OpenCvSharp) with OpenCL on the GPU.
       OpenCvSharpDir: directory of OpenCvSharp.dll (on the board:
       /usr/lib/opencvsharp). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenCvCheck</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OpenCvSharpDir Condition="'$(OpenCvSharpDir)' == ''">/usr/lib/opencvsharp</OpenCvSharpDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenCvSharp">
      <HintPath>$(OpenCvSharpDir)/OpenCvSharp.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
